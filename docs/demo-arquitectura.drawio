        <mxCell id="seed" value="Seed ficticio original&#10;data/plc-demo.json" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#171719;fontColor=#f7f7f7;strokeColor=#e10600;" vertex="1" parent="1">
