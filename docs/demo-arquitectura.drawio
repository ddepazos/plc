<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram name="PLC demo actual" id="plc-demo">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" page="1" pageWidth="1400" pageHeight="900">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ui" value="Frontend HTML / CSS / main.js&#10;Saldo, formularios, historial, detalle" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#171719;fontColor=#f7f7f7;strokeColor=#e10600;" vertex="1" parent="1">
