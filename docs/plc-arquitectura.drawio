<?xml version="1.0" encoding="utf-8"?>
<mxfile host="app.diagrams.net">
  <diagram id="plc-arquitectura-actual" name="PLC - frontend y backend">
    <mxGraphModel dx="1900" dy="1200" grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="1950" pageHeight="1200">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="github-pages" value="GitHub Pages · portada y seed&#10;Vista estática de solo lectura&#10;Abrir demo conectada → Render" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E8F3FF;strokeColor=#6C8EBF;fontColor=#222222;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="350" width="270" height="140" as="geometry" /></mxCell>
        <mxCell id="github-source" value="GitHub · ddepazos/plc · main&#10;Código + render.yaml&#10;Auto-deploy pendiente de verificar" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#E8F3FF;strokeColor=#6C8EBF;fontColor=#222222;fontSize=15;" vertex="1" parent="1"><mxGeometry x="750" y="350" width="330" height="130" as="geometry" /></mxCell>
        <mxCell id="pages-to-app" value="enlace HTTPS a Render" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" edge="1" parent="1" source="github-pages" target="frontend"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="source-to-render" value="desplegar código" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;dashed=1;" edge="1" parent="1" source="github-source" target="server"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="title" value="PLC · Arquitectura de la demo" style="text;html=0;align=center;fontSize=28;fontStyle=1;fontColor=#E10600;" vertex="1" parent="1"><mxGeometry x="550" y="25" width="850" height="50" as="geometry" /></mxCell>
        <mxCell id="browser" value="Visitante de la demo&#10;Navegador" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#171719;strokeColor=#E10600;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="230" height="100" as="geometry" /></mxCell>
        <mxCell id="frontend" value="Frontend · HTML/CSS/main.js&#10;Saldo, enviar, recibir, recargar, historial y detalle" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#171719;strokeColor=#E10600;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="350" y="130" width="320" height="140" as="geometry" /></mxCell>
        <mxCell id="server" value="Servidor Node · server.js&#10;Archivos públicos, Basic Auth en Render, Host/Origin y cabeceras" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#171719;strokeColor=#E10600;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="750" y="130" width="330" height="140" as="geometry" /></mxCell>
        <mxCell id="api" value="API · routes/api.js&#10;GET estado/billetera/historial/detalle&#10;POST enviar/recibir/recargar" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#171719;strokeColor=#E10600;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1160" y="130" width="330" height="140" as="geometry" /></mxCell>
        <mxCell id="rules" value="Reglas · transaction.js + wallet.js&#10;Validación, saldo e idempotencia" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#171719;strokeColor=#E10600;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1570" y="130" width="320" height="140" as="geometry" /></mxCell>
        <mxCell id="mode" value="¿DATABASE_URL?" style="rhombus;whiteSpace=wrap;html=0;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#333333;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1620" y="360" width="220" height="125" as="geometry" /></mxCell>
        <mxCell id="json" value="Desarrollo local · store.js&#10;backend/storage/demo.json&#10;cola de escritura" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#303034;strokeColor=#A8A8AD;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1240" y="590" width="300" height="125" as="geometry" /></mxCell>
        <mxCell id="postgres" value="Neon · PostgreSQL&#10;postgres-store.js&#10;transacciones SQL" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#303034;strokeColor=#A8A8AD;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1600" y="590" width="300" height="125" as="geometry" /></mxCell>
        <mxCell id="seed" value="Seed ficticio · data/plc-demo.json&#10;Cuenta y movimientos iniciales" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#171719;strokeColor=#E10600;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="770" y="590" width="330" height="125" as="geometry" /></mxCell>
        <mxCell id="fallback" value="Fallback del frontend&#10;Solo lectura si la API no responde" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#333333;fontSize=15;" vertex="1" parent="1"><mxGeometry x="350" y="590" width="320" height="125" as="geometry" /></mxCell>
        <mxCell id="migration" value="plc_bd/schema.sql + migrate.js&#10;Crea tablas antes del arranque en Neon" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#171719;strokeColor=#E10600;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1600" y="840" width="300" height="120" as="geometry" /></mxCell>
        <mxCell id="hosting" value="Ejecución: Node local o un servicio web Render. En Render, frontend y API comparten el mismo origen HTTPS; Neon guarda solo saldos y movimientos ficticios." style="shape=note;whiteSpace=wrap;html=0;fillColor=#E8F3FF;strokeColor=#6C8EBF;fontColor=#222222;fontSize=15;" vertex="1" parent="1"><mxGeometry x="50" y="860" width="690" height="130" as="geometry" /></mxCell>
        <mxCell id="scope" value="Una billetera demo compartida. No hay pagos, blockchain, registro de usuarios, sesiones ni autenticación de cuentas reales. La contraseña de Render restringe el acceso a la demo; no crea usuarios PLC." style="shape=note;whiteSpace=wrap;html=0;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#333333;fontSize=15;" vertex="1" parent="1"><mxGeometry x="770" y="860" width="640" height="130" as="geometry" /></mxCell>
        <mxCell id="e1" value="abre" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" edge="1" parent="1" source="browser" target="frontend"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" value="HTTP mismo origen" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" edge="1" parent="1" source="frontend" target="server"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" edge="1" parent="1" source="server" target="api"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" edge="1" parent="1" source="api" target="rules"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" edge="1" parent="1" source="rules" target="mode"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" value="no" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" edge="1" parent="1" source="mode" target="json"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="sí" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" edge="1" parent="1" source="mode" target="postgres"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="primer inicio" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" edge="1" parent="1" source="seed" target="json"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" value="base vacía" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" edge="1" parent="1" source="seed" target="postgres"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" edge="1" parent="1" source="seed" target="fallback"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" value="solo lectura" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" edge="1" parent="1" source="fallback" target="frontend"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="migración" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;" edge="1" parent="1" source="migration" target="postgres"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
