# PLC cloud deployment example
NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# Neon PostgreSQL connection string. Never commit the real value.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Comma-separated frontend origins allowed to call the API.
# Example GitHub Pages origin:
ALLOWED_ORIGINS=https://ddepazos.github.io
